#!/bin/sh
#
# Blocks direct pushes to `main`. All changes to the live site should go
# through a pull request so they can be previewed and approved first.
#
# This is an accident-prevention guardrail for contributors, not a hard
# security boundary (an advanced user can intentionally skip it with
# `git push --no-verify`). It is auto-enabled by the "prepare" script in
# package.json when you run `npm install`.

protected_branch="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_branch" ]; then
    echo ""
    echo "  ⛔  Direct pushes to 'main' are blocked."
    echo ""
    echo "  Changes to the live website go through a pull request so they can be"
    echo "  previewed and approved before going live. To make a change:"
    echo ""
    echo "    • In Claude Code, just use the  /edit-website  skill, or"
    echo "    • Create a branch first:   git switch -c my-change"
    echo ""
    exit 1
  fi
done

exit 0
